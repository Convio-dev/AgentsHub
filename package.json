{
  "name": "agents-hub-sidecar",
  "version": "1.0.0",
  "description": "High-Performance Cross-Platform Desktop Sidecar Engine for AgentsHub",
  "author": "ZerroDevs (https://github.com/ZerroDevs)",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/engine.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/engine.ts --port=0 --token=dev-secret",
    "build": "bun run build.ts",
    "build:all": "bun run build.ts --all",
    "build:win": "bun run build.ts --target=win-x64",
    "build:mac": "bun run build.ts --target=osx-arm64",
    "build:linux": "bun run build.ts --target=linux-x64",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0"
  }
}
